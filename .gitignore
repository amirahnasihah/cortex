# =============================================================================
# standard-repo — comprehensive stack gitignore
# Copy/adapt sections per project; delete what you don't use.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
*.secrets
secrets/
.secrets/
credentials.json
credentials.yml
service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
.aws/credentials
.aws/config
.netrc
.npmrc
!.npmrc.example
.pypirc
.doppler.yaml
.sentryclirc

# -----------------------------------------------------------------------------
